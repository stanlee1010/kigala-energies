# Copy to .env and adjust. Never commit the real .env.
APP_ENV=production
# Long random string: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Production database (leave empty for local SQLite in database/petrol_station.db)
# PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/petrol_station
# MySQL:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/petrol_station

# Used only when the database is created for the first time
STATION_NAME=Kigala Energies
STATION_TIMEZONE=Africa/Dar_es_Salaam
STATION_CURRENCY=TZS
MANAGER_USERNAME=manager
MANAGER_PASSWORD=ChangeMe123!

DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=Director123!

# On the internet: force HTTPS (redirect + HSTS + Secure cookies)
FORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12
# Behind a proxy / load balancer (Render, Nginx): number of proxies to trust for the client IP.
# Leave 0 when the app is reached directly (e.g. on the station Wi-Fi) - otherwise IPs can be faked.
TRUST_PROXY=0

# Login protection per device (IP): attempts allowed per window (seconds)
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=600

# Background checks (shift creation, first-Wednesday rollover, alerts)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Optional storage locations
# UPLOAD_DIR=/data/uploads
# REPORTS_DIR=/data/reports
